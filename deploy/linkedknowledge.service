[Unit]
Description=LinkedKnowledge
After=network.target mysql.service redis-server.service
Requires=mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/linkedknowledge
EnvironmentFile=/opt/linkedknowledge/.env
ExecStart=/usr/bin/java -Xms192m -Xmx384m -jar /opt/linkedknowledge/app.jar
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
